{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iflow-pilot/spec-schema.json",
  "title": "iFlow spec v1",
  "description": "Integration flow: one trigger, ordered steps, one end, plus an optional exception subprocess that runs when any step fails. Routers branch on the main line into routes that end or continue with the step after the router. A splitter on the main line makes the steps after it run once per item, until a gather or the end. Local processes are called with a processCall step. Mapping is not supported yet. Externalized parameters ({{Name}}) are supported as the whole URL, credentialName or locationId of an HTTP receiver, and as a constant header or property value. HTTP receivers: authType None, Basic or OAuth2 Client Credentials with a credentialName (never a secret), proxyType Internet or On-Premise with an optional locationId, and a timeout in ms.",
  "type": "object",
  "required": [
    "id",
    "name",
    "packageId",
    "trigger",
    "steps",
    "end"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$",
      "maxLength": 100,
      "description": "Technical iFlow id (letters, digits, underscore)."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Display name."
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "packageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.]+$",
      "description": "Target package id."
    },
    "trigger": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "httpsSender",
            "timer"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "httpsSender"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/httpsSender"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "timer"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/timer"
          }
        }
      ]
    },
    "steps": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/definitions/step"
      }
    },
    "end": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "httpReceiver",
            "none"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "httpReceiver"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/httpReceiver"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "none"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/noEnd"
          }
        }
      ]
    },
    "exceptionSubprocess": {
      "type": "object",
      "required": [
        "steps"
      ],
      "additionalProperties": false,
      "description": "Exception Subprocess: runs when any step of the main flow fails, instead of the normal end. Its steps run in order and end with its end event (Message End by default), so for an HTTPS trigger the resulting message is returned to the sender as the response. The error text is available as ${exception.message}. Set header CamelHttpResponseCode (e.g. 500) to return an HTTP error status instead of 200.",
      "properties": {
        "name": {
          "$ref": "#/definitions/stepName",
          "description": "Optional display name; defaults to Exception Subprocess 1."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/exceptionStep"
          }
        },
        "end": {
          "$ref": "#/definitions/endEvent",
          "description": "End event of the subprocess. Default message (failed messages then look completed in monitoring); prefer escalation or error"
        }
      }
    },
    "localProcesses": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/definitions/localProcess"
      },
      "description": "Local integration processes, each called by processCall steps (main line, routes or exception subprocess); their steps: contentModifier, groovyScript, jsonToXml, xmlToJson, requestReplyHttp, writeVariables, router (its routes continue or end with a plain End, { \"event\": \"message\" })"
    },
    "parameters": {
      "type": "object",
      "description": "Externalized parameters: name -> default value. Reference them as {{Name}}.",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "resources": {
      "type": "array",
      "description": "Attached XSLT files (with extension) added to the iFlow as src/main/resources/mapping/<file>. v1 has no XSLT step: the user wires an XSLT Mapping step to the file in the CPI web editor.",
      "uniqueItems": true,
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]*\\.xslt?$"
      }
    }
  },
  "definitions": {
    "stepName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "description": "Optional display name; defaults like 'Content Modifier 1'."
    },
    "systemName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]+$",
      "maxLength": 50,
      "description": "Optional receiver system (participant) name; defaults to Receiver / Receiver1..n."
    },
    "httpMethod": {
      "enum": [
        "GET",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ]
    },
    "authType": {
      "enum": [
        "None",
        "Basic",
        "OAuth2 Client Credentials"
      ],
      "description": "Receiver authentication. Basic and OAuth2 Client Credentials need credentialName: the name of security material deployed in CPI (never the password or secret itself)."
    },
    "httpsSender": {
      "type": "object",
      "required": [
        "type",
        "address"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "httpsSender"
        },
        "address": {
          "type": "string",
          "pattern": "^(/[A-Za-z0-9_.~-]+)+$",
          "description": "Endpoint path, e.g. /orders/create"
        }
      }
    },
    "timer": {
      "type": "object",
      "required": [
        "type",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "timer"
        },
        "mode": {
          "enum": [
            "once",
            "every"
          ],
          "description": "once: run once after deployment; every: repeat every `minutes` minutes, all day, time zone UTC"
        },
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "description": "With mode every: the interval in minutes (only values in the reference exports, e.g. 15)"
        }
      }
    },
    "tableEntry": {
      "type": "object",
      "required": [
        "name",
        "type",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "type": {
          "enum": [
            "constant",
            "expression",
            "header",
            "property",
            "xpath",
            "globalVariable",
            "localVariable"
          ],
          "description": "Source of the value: constant; Camel simple expression like ${header.X}; header, property, global or local variable (value = its name); xpath (value = the XPath, datatype defaults to java.lang.String)"
        },
        "value": {
          "type": "string",
          "description": "The value; for a constant also a whole {{Parameter}} (an externalized value, defined in parameters)"
        },
        "datatype": {
          "type": "string",
          "description": "Optional Java type, e.g. java.lang.String (default for xpath)"
        },
        "default": {
          "type": "string",
          "description": "Optional: the Content Modifier's Default column"
        }
      }
    },
    "contentModifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "contentModifier"
        },
        "name": {
          "$ref": "#/definitions/stepName"
        },
        "description": {
          "$ref": "#/definitions/stepDescription"
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tableEntry"
          }
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/tableEntry"
          }
        },
        "body": {
          "type": "string",
          "description": "New message body (Camel simple expression allowed). Omit to keep the body."
        }
      }
    },
    "groovyScript": {
      "type": "object",
      "required": [
        "type",
        "fileName"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "groovyScript"
        },
        "name": {
          "$ref": "#/definitions/stepName"
        },
        "description": {
          "$ref": "#/definitions/stepDescription"
        },
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "description": "Without extension; stored as script/<fileName>.groovy. If the user attached <fileName>.groovy, omit code: the attached file is used."
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Groovy source. Omit it when <fileName>.groovy is an attached file."
        }
      }
    },
    "writeVariables": {
      "type": "object",
      "required": [
        "type",
        "variables"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "writeVariables"
        },
        "name": {
          "$ref": "#/definitions/stepName"
        },
        "description": {
          "$ref": "#/definitions/stepDescription"
        },
        "variables": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "name",
              "type",
              "value"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,99}$",
                "description": "Variable name"
              },
              "type": {
                "enum": [
                  "property",
                  "xpath"
                ],
                "description": "property: value = an exchange property name; xpath: value = the XPath"
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "datatype": {
                "type": "string",
                "description": "For xpath: Java type, default java.lang.String"
              },
              "global": {
                "type": "boolean",
                "description": "Global Scope: visible to all iFlows of the tenant (default false: this iFlow only)"
              }
            }
          }
        }
      }
    },
    "router": {
      "type": "object",
      "required": [
        "type",
        "expressionType",
        "routes"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "router"
        },
        "name": {
          "$ref": "#/definitions/stepName"
        },
        "description": {
          "$ref": "#/definitions/stepDescription"
        },
        "expressionType": {
          "enum": [
            "XML",
            "NonXML"
          ],
          "description": "Condition type of all routes: XML (XPath) or NonXML (Camel simple)"
        },
        "routes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "$ref": "#/definitions/route"
          }
        }
      }
    },
    "route": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Route name, unique within the router"
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "description": "XML: an XPath condition, e.g. /root/type = 'X'. NonXML: a Camel simple condition with spaces around the operator, e.g. ${property.x} = 'A'. Not on the default route."
        },
        "default": {
          "const": true,
          "description": "The default route: exactly one per router, listed last, without a condition"
        },
        "steps": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/step"
          },
          "description": "Steps of this route (no router, splitter or gather). Without an end, the route continues with the step after the router."
        },
        "end": {
          "$ref": "#/definitions/endEvent",
          "description": "The route ends here. Missing: it continues with the step after the router."
        }
      }
    },
    "endEvent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event": {
          "enum": [
            "message",
            "escalation",
            "error"
          ],
          "description": "message: completed; escalation: escalated in monitoring; error: failed"
        },
        "name": {
          "$ref": "#/definitions/stepName"
        },
        "category": {
          "enum": [
            "Others",
            "RoutingConditionNotMet"
          ],
          "description": "Escalation End only: the escalation category shown in monitoring. Others (default, 'Others - not further qualified') or RoutingConditionNotMet ('Routing condition not met')"
        }
      }
    },
    "converter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "jsonToXml",
            "xmlToJson"
          ]
        },
        "name": {
          "$ref": "#/definitions/stepName"
        },
        "description": {
          "$ref": "#/definitions/stepDescription"
        }
      }
    },
    "httpCall": {
      "properties": {
        "system": {
          "$ref": "#/definitions/systemName"
        },
        "url": {
          "type": "string",
          "pattern": "^(https?://\\S+|\\{\\{[A-Za-z][A-Za-z0-9_]*\\}\\})$",
          "description": "Full URL or a whole {{Parameter}} reference"
        },
        "method": {
          "$ref": "#/definitions/httpMethod"
        },
        "authType": {
          "$ref": "#/definitions/authType"
        },
        "credentialName": {
          "type": "string",
          "pattern": "^([A-Za-z0-9_.-]{1,150}|\\{\\{[A-Za-z][A-Za-z0-9_]*\\}\\})$",
          "description": "Name of the deployed security material (User Credentials or OAuth2 Client Credentials) in CPI, or a whole {{Parameter}} with the name as its default. A name only, never a password or secret. Required unless authType is None."
        },
        "proxyType": {
          "enum": [
            "Internet",
            "On-Premise"
          ],
          "description": "Internet (default) or On-Premise (through the Cloud Connector)"
        },
        "locationId": {
          "type": "string",
          "pattern": "^([A-Za-z0-9_.-]{1,100}|\\{\\{[A-Za-z][A-Za-z0-9_]*\\}\\})$",
          "description": "Cloud Connector location ID, or a whole {{Parameter}}; only with proxyType On-Premise, optional (empty: the default location)"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "description": "Request timeout in milliseconds (default 60000)"
        }
      }
    },
    "requestReplyHttp": {
      "type": "object",
      "required": [
        "type",
        "url",
        "method",
        "authType"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/definitions/httpCall"
        }
      ],
      "properties": {
        "type": {
          "const": "requestReplyHttp"
        },
        "name": {
          "$ref": "#/definitions/stepName"
        },
        "description": {
          "$ref": "#/definitions/stepDescription"
        },
        "system": true,
        "url": true,
        "method": true,
        "authType": true,
        "credentialName": true,
        "proxyType": true,
        "locationId": true,
        "timeout": true
      }
    },
    "httpReceiver": {
      "type": "object",
      "required": [
        "type",
        "url",
        "method",
        "authType"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "$ref": "#/definitions/httpCall"
        }
      ],
      "properties": {
        "type": {
          "const": "httpReceiver"
        },
        "system": true,
        "url": true,
        "method": true,
        "authType": true,
        "credentialName": true,
        "proxyType": true,
        "locationId": true,
        "timeout": true
      }
    },
    "noEnd": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "none"
        },
        "event": {
          "enum": [
            "message",
            "escalation",
            "error"
          ],
          "description": "Optional end event of the main flow; default message"
        },
        "category": {
          "enum": [
            "Others",
            "RoutingConditionNotMet"
          ],
          "description": "With event escalation: the escalation category (default Others)"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "contentModifier",
            "groovyScript",
            "jsonToXml",
            "xmlToJson",
            "requestReplyHttp",
            "writeVariables",
            "router",
            "splitter",
            "gather",
            "processCall"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "contentModifier"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/contentModifier"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "groovyScript"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/groovyScript"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jsonToXml"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/converter"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "xmlToJson"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/converter"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "requestReplyHttp"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/requestReplyHttp"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "writeVariables"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/writeVariables"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "router"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/router"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "splitter"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/splitter"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "gather"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/gather"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "processCall"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/processCall"
          }
        }
      ]
    },
    "exceptionStep": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "contentModifier",
            "groovyScript",
            "jsonToXml",
            "xmlToJson",
            "processCall"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "contentModifier"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/contentModifier"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "groovyScript"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/groovyScript"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jsonToXml"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/converter"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "xmlToJson"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/converter"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "processCall"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/processCall"
          }
        }
      ]
    },
    "stepDescription": {
      "type": "string",
      "maxLength": 500,
      "description": "What the step is for (shown in the proposal panel; not written to the iFlow). Imported placeholders say what to replace them with."
    },
    "splitter": {
      "type": "object",
      "required": [
        "type",
        "kind",
        "expression",
        "stopOnException"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "splitter"
        },
        "name": {
          "$ref": "#/definitions/stepName"
        },
        "description": {
          "$ref": "#/definitions/stepDescription"
        },
        "kind": {
          "enum": [
            "iterating",
            "general"
          ],
          "description": "iterating: each item on its own (Iterating Splitter); general: each item with the enveloping elements above it (General Splitter)"
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "XPath of the items, e.g. //order (the only expression type supported)"
        },
        "grouping": {
          "type": "integer",
          "minimum": 1,
          "description": "Items per split message, default 1"
        },
        "streaming": {
          "type": "boolean",
          "description": "Streaming, default true"
        },
        "stopOnException": {
          "type": "boolean",
          "description": "Required, no default: true = one failing item stops the rest, false = the other items still run"
        },
        "parallel": {
          "const": false,
          "description": "Parallel Processing: only off (false) is supported"
        }
      }
    },
    "gather": {
      "type": "object",
      "required": [
        "type",
        "source",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "gather"
        },
        "name": {
          "$ref": "#/definitions/stepName"
        },
        "description": {
          "$ref": "#/definitions/stepDescription"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Combine at XPath: the XPath of the items in each split message, e.g. //order"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Combine at XPath: the element that holds the combined items, e.g. /orders"
        }
      },
      "description": "Gather: combines the split messages again (XML, Same Format, Combine at XPath); after a splitter on the main line"
    },
    "processCall": {
      "type": "object",
      "required": [
        "type",
        "process"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "processCall"
        },
        "name": {
          "$ref": "#/definitions/stepName"
        },
        "description": {
          "$ref": "#/definitions/stepDescription"
        },
        "process": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Name of the local process it calls (localProcesses[].name)"
        },
        "loop": {
          "type": "object",
          "required": [
            "condition",
            "max"
          ],
          "additionalProperties": false,
          "description": "Looping Process Call: calls the local process again while the condition is true, at most max times",
          "properties": {
            "condition": {
              "type": "string",
              "minLength": 1,
              "description": "Non-XML condition with spaces around the operator, e.g. ${property.hasMore} = 'true'"
            },
            "max": {
              "type": "integer",
              "minimum": 1,
              "description": "Max. number of iterations"
            }
          }
        }
      }
    },
    "localProcess": {
      "type": "object",
      "required": [
        "name",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Local process name, unique; a processCall names it"
        },
        "description": {
          "$ref": "#/definitions/stepDescription"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/definitions/localStep"
          }
        }
      }
    },
    "localStep": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "contentModifier",
            "groovyScript",
            "jsonToXml",
            "xmlToJson",
            "requestReplyHttp",
            "writeVariables",
            "router"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "contentModifier"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/contentModifier"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "groovyScript"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/groovyScript"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "jsonToXml"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/converter"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "xmlToJson"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/converter"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "requestReplyHttp"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/requestReplyHttp"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "writeVariables"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/writeVariables"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "router"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/router"
          }
        }
      ]
    }
  },
  "examples": [
    {
      "id": "Order_Forward",
      "name": "Order Forward",
      "description": "Receives an order via HTTPS, tags it and forwards it as XML",
      "packageId": "PilotReference",
      "trigger": {
        "type": "httpsSender",
        "address": "/orders/forward"
      },
      "steps": [
        {
          "type": "contentModifier",
          "headers": [
            {
              "name": "Source",
              "type": "constant",
              "value": "Pilot"
            }
          ],
          "properties": [
            {
              "name": "OrderId",
              "type": "expression",
              "value": "${header.OrderId}"
            }
          ]
        },
        {
          "type": "jsonToXml"
        }
      ],
      "end": {
        "type": "httpReceiver",
        "url": "{{TargetURL}}",
        "method": "POST",
        "authType": "None"
      },
      "parameters": {
        "TargetURL": "https://example.org/orders"
      }
    },
    {
      "id": "Nightly_Ping",
      "name": "Nightly Ping",
      "packageId": "PilotReference",
      "trigger": {
        "type": "timer",
        "mode": "once"
      },
      "steps": [
        {
          "type": "requestReplyHttp",
          "url": "https://example.org/ping",
          "method": "GET",
          "authType": "None"
        }
      ],
      "end": {
        "type": "none"
      }
    },
    {
      "id": "Order_Json_To_Xml",
      "name": "Order JSON to XML",
      "description": "Converts an order to XML; on any error returns a JSON error body with HTTP 500",
      "packageId": "PilotReference",
      "trigger": {
        "type": "httpsSender",
        "address": "/orders/json-to-xml"
      },
      "steps": [
        {
          "type": "jsonToXml"
        }
      ],
      "end": {
        "type": "none"
      },
      "exceptionSubprocess": {
        "steps": [
          {
            "type": "contentModifier",
            "name": "Set Error Body",
            "headers": [
              {
                "name": "CamelHttpResponseCode",
                "type": "constant",
                "value": "500"
              },
              {
                "name": "Content-Type",
                "type": "constant",
                "value": "application/json"
              }
            ],
            "body": "{\"status\": \"Failed\", \"error\": \"${exception.message}\"}"
          }
        ]
      }
    }
  ]
}
