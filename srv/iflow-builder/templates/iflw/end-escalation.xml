                    <ifl:property>
                        <key>cmdVariantUri</key>
                        <value>ctype::FlowstepVariant/cname::EscalationEndEvent/version::1.0.0</value>
                    </ifl:property>
                    <ifl:property>
                        <key>activityType</key>
