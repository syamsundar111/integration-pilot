        <bpmn2:exclusiveGateway default="{{DEFAULT}}" id="{{ID}}" name="{{NAME}}">
            <bpmn2:extensionElements>
                <ifl:property>
                    <key>componentVersion</key>
                    <value>1.2</value>
                </ifl:property>
                <ifl:property>
                    <key>activityType</key>
                    <value>ExclusiveGateway</value>
                </ifl:property>
                <ifl:property>
                    <key>cmdVariantUri</key>
                    <value>ctype::FlowstepVariant/cname::ExclusiveGateway/version::1.2.0</value>
                </ifl:property>
                <ifl:property>
                    <key>throwException</key>
                    <value>false</value>
                </ifl:property>
            </bpmn2:extensionElements>
            <bpmn2:incoming>{{INCOMING}}</bpmn2:incoming>
            <bpmn2:outgoing>{{OUTGOING}}</bpmn2:outgoing>
        </bpmn2:exclusiveGateway>
