{
  "_version": "2.0.0",
  "sap.app": {
    "id": "integration.pilot",
    "type": "application",
    "i18n": {
      "bundleUrl": "i18n/i18n.properties",
      "supportedLocales": [
        ""
      ],
      "fallbackLocale": ""
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "applicationVersion": {
      "version": "1.0.0"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": false
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.136.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.tnt": {},
        "sap.ui.layout": {},
        "sap.ui.unified": {},
        "sap.ui.codeeditor": {
          "lazy": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "integration.pilot.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "rootView": {
      "viewName": "integration.pilot.view.App",
      "type": "XML",
      "id": "app"
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "type": "View",
        "viewType": "XML",
        "path": "integration.pilot.view",
        "controlId": "pageContainer",
        "controlAggregation": "pages",
        "bypassed": {
          "target": "notFound"
        }
      },
      "routes": [
        {
          "name": "dashboard",
          "pattern": "",
          "target": "dashboard"
        },
        {
          "name": "monitor",
          "pattern": "monitor:?query:",
          "target": "monitor"
        },
        {
          "name": "generate",
          "pattern": "generate:?query:",
          "target": "generate"
        },
        {
          "name": "packages",
          "pattern": "packages:?query:",
          "target": "packages"
        },
        {
          "name": "iflows",
          "pattern": "iflows:?query:",
          "target": "iflows"
        },
        {
          "name": "activity",
          "pattern": "activity",
          "target": "activity"
        }
      ],
      "targets": {
        "dashboard": {
          "id": "dashboard",
          "name": "Dashboard",
          "level": 1
        },
        "monitor": {
          "id": "monitor",
          "name": "Monitor",
          "level": 1
        },
        "generate": {
          "id": "generate",
          "name": "Generate",
          "level": 1
        },
        "packages": {
          "id": "packages",
          "name": "Packages",
          "level": 1
        },
        "iflows": {
          "id": "iflows",
          "name": "Iflows",
          "level": 1
        },
        "activity": {
          "id": "activity",
          "name": "Activity",
          "level": 1
        },
        "notFound": {
          "id": "notFound",
          "name": "NotFound",
          "level": 1
        }
      }
    }
  }
}
