<mvc:View controllerName="integration.pilot.controller.Activity" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core">
  <f:DynamicPage id="page" toggleHeaderOnTitleClick="false">
    <f:title>
      <f:DynamicPageTitle>
        <f:heading><Title text="Activity" level="H2" /></f:heading>
        <f:expandedContent><Text text="AI usage and every write — from the UI and from approved proposals — successful or not." /></f:expandedContent>
        <f:actions>
          <!-- one period for the whole page: figures, charts and the log -->
          <SegmentedButton selectedKey="{view>/days}" selectionChange=".onPeriod">
            <items>
              <SegmentedButtonItem key="7" text="7 days" />
              <SegmentedButtonItem key="30" text="30 days" />
              <SegmentedButtonItem key="90" text="90 days" />
            </items>
          </SegmentedButton>
          <Button text="Refresh" icon="sap-icon://refresh" press=".onRefresh" />
        </f:actions>
      </f:DynamicPageTitle>
    </f:title>
    <f:content>
      <VBox renderType="Bare" class="ipGapM">
        <!-- AI usage of chat requests (GET /api/usage): figures, tokens per day and per model -->
        <Panel expandable="true" expanded="true" class="ipCard" busy="{view>/usageBusy}" busyIndicatorDelay="0">
          <headerToolbar>
            <Toolbar style="Clear"><Title text="AI usage" level="H5" /></Toolbar>
          </headerToolbar>
          <MessageStrip text="{= 'AI usage could not be loaded: ' + ${view>/usageError} }" type="Error" showIcon="true" visible="{= !!${view>/usageError} }" class="sapUiSmallMarginBottom" />
          <HBox renderType="Bare" class="ipUsageKpis">
            <VBox renderType="Bare"><Label text="Requests" /><Title text="{view>/usage/totals/requests}" level="H3" /><Text text="{= ${view>/usage/totals/failed} + ' failed' }" class="ipSubtle" /></VBox>
            <VBox renderType="Bare"><Label text="Model calls" /><Title text="{view>/usage/totals/modelCalls}" level="H3" /></VBox>
            <VBox renderType="Bare"><Label text="Input tokens" /><Title text="{path: 'view>/usage/totals/inputTokens', formatter: '.formatter.tokens'}" level="H3" /></VBox>
            <VBox renderType="Bare"><Label text="Output tokens" /><Title text="{path: 'view>/usage/totals/outputTokens', formatter: '.formatter.tokens'}" level="H3" /></VBox>
            <VBox renderType="Bare"><Label text="Tokens per request" /><Title text="{path: 'view>/usage/totals/avgTokensPerRequest', formatter: '.formatter.tokens'}" level="H3" /></VBox>
            <VBox renderType="Bare">
              <Label text="Budget per message" />
              <Title text="{path: 'view>/usage/budget/limit', formatter: '.formatter.tokens'}" level="H3" />
              <Text text="{parts: ['view>/usage/budget/maxPerRequest', 'view>/usage/budget/maxShare', 'view>/usage/budget/stoppedAtBudget'], formatter: '.budgetText'}" class="ipSubtle" />
            </VBox>
          </HBox>
          <!-- column charts, half the width each (stacked on narrow screens); they grow with new days and models -->
          <HBox renderType="Bare" class="ipChartGrid sapUiMediumMarginTop">
            <VBox renderType="Bare" class="ipChartCard">
              <Title text="Tokens per day" level="H5" />
              <VBox id="tokensByDayChart" renderType="Bare" visible="{= ${view>/usage/totals/requests} > 0 }" />
              <Text text="No chat requests in this period" visible="{= !${view>/usage/totals/requests} }" class="ipSubtle ipChartEmpty" />
            </VBox>
            <VBox renderType="Bare" class="ipChartCard">
              <Title text="Tokens per model" level="H5" />
              <VBox id="tokensByModelChart" renderType="Bare" visible="{= ${view>/usage/byModel}.length > 0 }" />
              <Text text="No model calls in this period" visible="{= !${view>/usage/byModel}.length }" class="ipSubtle ipChartEmpty" />
            </VBox>
          </HBox>
        </Panel>

        <!-- the log: paged on the server, scrolls inside a limited height so the page does not grow -->
        <Panel expandable="true" expanded="true" class="ipCard">
          <headerToolbar>
            <OverflowToolbar style="Clear">
              <Title text="{= 'Activity log · ' + ${view>/entries}.length + (${view>/more} ? '+' : '') }" level="H5" />
              <ToolbarSpacer />
              <SearchField width="16rem" placeholder="Search target or user" search=".onSearch" value="{view>/search}" />
              <Select selectedKey="{view>/action}" items="{view>/actions}" change=".loadLog" width="13rem" tooltip="Action">
                <core:Item key="{view>key}" text="{view>text}" />
              </Select>
              <Select selectedKey="{view>/status}" change=".loadLog" width="9rem" tooltip="Result">
                <core:Item key="" text="All results" />
                <core:Item key="SUCCESS" text="Success" />
                <core:Item key="FAILED" text="Failed" />
              </Select>
            </OverflowToolbar>
          </headerToolbar>
          <VBox renderType="Bare" class="ipLogScroll">
            <Table items="{view>/entries}" busy="{view>/busy}" busyIndicatorDelay="0" sticky="ColumnHeaders">
              <infoToolbar>
                <OverflowToolbar visible="{= !!${view>/logError} }" design="Info">
                  <Text text="{= 'The activity log could not be loaded: ' + ${view>/logError} }" />
                </OverflowToolbar>
              </infoToolbar>
              <noData>
                <IllustratedMessage
                  illustrationType="{= ${view>/filtered} ? 'sapIllus-NoFilterResults' : 'sapIllus-NoActivities' }"
                  illustrationSize="ExtraSmall"
                  enableVerticalResponsiveness="true"
                  title="{= ${view>/filtered} ? 'No matching entries' : 'No activity in this period' }"
                  description="{= ${view>/filtered} ? 'Adjust the search or the filters.' : 'Create a package, deploy an iFlow or approve a proposal — it will be recorded here.' }"
                />
              </noData>
              <columns>
                <Column width="9rem"><Text text="When" /></Column>
                <Column><Text text="Action" /></Column>
                <Column><Text text="Target" /></Column>
                <Column minScreenWidth="Tablet" demandPopin="true"><Text text="User" /></Column>
                <Column width="8rem"><Text text="Result" /></Column>
              </columns>
              <items>
                <ColumnListItem type="{= ${view>details} ? 'Navigation' : 'Inactive' }" press=".onDetails">
                  <cells>
                    <Text text="{path: 'view>createdAt', formatter: '.formatter.relativeTime'}" tooltip="{path: 'view>createdAt', formatter: '.formatter.dateTime'}" />
                    <Text text="{path: 'view>action', formatter: '.formatter.humanize'}" class="sapMTextBold" />
                    <ObjectIdentifier title="{view>targetId}" text="{view>targetType}" />
                    <Text text="{view>user}" />
                    <ObjectStatus text="{view>status}" state="{path: 'view>status', formatter: '.formatter.statusState'}" inverted="true" class="ipNoWrap" />
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
            <HBox justifyContent="Center" visible="{view>/more}" class="sapUiSmallMarginTopBottom">
              <Button text="Load more" icon="sap-icon://drill-down" press=".onLoadMore" busy="{view>/busy}" busyIndicatorDelay="0" />
            </HBox>
          </VBox>
        </Panel>
      </VBox>
    </f:content>
  </f:DynamicPage>
</mvc:View>
